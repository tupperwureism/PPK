@startuml
skinparam defaultTextAlignment center
skinparam roundcorner 12
skinparam shadowing false
skinparam ArrowColor #5D6D7E
skinparam ArrowFontSize 10

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #BDC3C7
    BorderThickness 1.5
    FontName Arial
    FontSize 11
}

skinparam card {
    BackgroundColor #FEF9E7
    BorderColor #F1C40F
    BorderThickness 1.5
    FontName Arial
    FontSize 11
    FontStyle bold
}

rectangle "<color:white><b>Start</b></color>" as Start #4D6BFE
rectangle "Buka Halaman\nKatalog Fasilitas" as Step_1
rectangle "Filter Pencarian\n(Tipe/Lokasi/Kapasitas)" as Step_2 #FAD7A0
card "◇ Fasilitas\nDitemukan?" as Dec_1
rectangle "Pilih Fasilitas &\nTentukan Tanggal" as Step_3
rectangle "Tampilkan Matriks Slot Waktu\n(07.00-20.00, Interval 30m)" as Step_4 #D4EFDF;line:27AE60
rectangle "Tampilkan Notifikasi:\nFasilitas Tidak Ditemukan" as Step_Err #FDEDEC;line:E74C3C
rectangle "<color:white><b>End</b></color>" as End #4D6BFE

Start -right-> Step_1
Step_1 -right-> Step_2
Step_2 -right-> Dec_1

Dec_1 -right-> Step_3 : Ya
Step_3 -right-> Step_4
Step_4 -right-> End

Dec_1 -down-> Step_Err : Tidak
Step_Err -right-> End
@enduml