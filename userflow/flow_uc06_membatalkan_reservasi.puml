@startuml
skinparam defaultTextAlignment center
skinparam roundcorner 12
skinparam shadowing false
skinparam ArrowColor #5D6D7E
skinparam ArrowFontSize 10

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #BDC3C7
    BorderThickness 1.5
    FontName Arial
    FontSize 11
}

skinparam card {
    BackgroundColor #FEF9E7
    BorderColor #F1C40F
    BorderThickness 1.5
    FontName Arial
    FontSize 11
    FontStyle bold
}

skinparam database {
    BackgroundColor #2C3E50
    BorderColor #1A252F
    FontColor white
    FontName Arial
    FontSize 11
    FontStyle bold
}

' Row 1: Validasi Deadline
rectangle "<color:white><b>Start</b></color>" as Start #4D6BFE
rectangle "Pilih Reservasi Aktif\ndan Klik 'Batalkan'" as Step_1
card "◇ Sebelum\nBatas Waktu?" as Dec_1
rectangle "Tampilkan Pesan:\nLewat Batas Waktu" as Step_Err #FDEDEC;line:E74C3C

' Row 2: Konfirmasi & Update DB
card "◇ Konfirmasi\nBatalkan?" as Dec_2
rectangle "Ubah Status 'Dibatalkan'\ndan Bebaskan Slot Waktu" as Step_2 #FAD7A0;line:E67E22
database "Database\nReservasi" as DB_Reserve
rectangle "Notifikasi Sukses dan\nJadwal Terupdate" as Step_3 #D4EFDF;line:27AE60
rectangle "<color:white><b>End</b></color>" as End #4D6BFE

' Row 1 Flow
Start -right-> Step_1
Step_1 -right-> Dec_1
Dec_1 -right-> Step_Err : Lewat Batas
Step_Err -down-> End

' Down to Row 2
Dec_1 -down-> Dec_2 : Masih Berlaku

' Row 2 Flow
Dec_2 -right-> Step_2 : Ya (Batalkan)
Step_2 -right-> DB_Reserve
DB_Reserve -right-> Step_3
Step_3 -right-> End

Dec_2 -down-> End : Tidak Jadi

' Constraint
Dec_1 -[hidden]right- Step_Err
@enduml