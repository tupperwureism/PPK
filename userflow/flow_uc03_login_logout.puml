@startuml
skinparam defaultTextAlignment center
skinparam roundcorner 12
skinparam shadowing false
skinparam ArrowColor #5D6D7E
skinparam ArrowFontSize 10

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #BDC3C7
    BorderThickness 1.5
    FontName Arial
    FontSize 11
}

skinparam card {
    BackgroundColor #FEF9E7
    BorderColor #F1C40F
    BorderThickness 1.5
    FontName Arial
    FontSize 11
    FontStyle bold
}

' Row 1: Login
rectangle "<color:white><b>Start</b></color>" as Start #4D6BFE
rectangle "Buka Halaman\nLogin" as Step_1
rectangle "Input Email & Password\nlalu Klik 'Login'" as Step_2 #FAD7A0
card "◇ Kredensial Valid &\nAkun Aktif?" as Dec_1
rectangle "Tampilkan Error:\nEmail/Password Salah" as Step_Err #FDEDEC;line:E74C3C

' Row 2: Sesi & Logout
rectangle "Buat Sesi & Masuk\nDashboard Utama" as Step_3 #D4EFDF;line:27AE60
rectangle "Klik Tombol\n'Logout'" as Step_4
rectangle "Hancurkan Sesi &\nKembali ke Login" as Step_5 #FAD7A0
rectangle "<color:white><b>End</b></color>" as End #4D6BFE

' Row 1 Flow
Start -right-> Step_1
Step_1 -right-> Step_2
Step_2 -right-> Dec_1

Dec_1 -right-> Step_Err : Salah
Step_Err -down-> End

' Down to Row 2
Dec_1 -down-> Step_3 : Valid

' Row 2 Flow
Step_3 -right-> Step_4
Step_4 -right-> Step_5
Step_5 -right-> End
@enduml