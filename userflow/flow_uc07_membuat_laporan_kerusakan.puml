@startuml
skinparam defaultTextAlignment center
skinparam roundcorner 12
skinparam shadowing false
skinparam ArrowColor #5D6D7E
skinparam ArrowFontSize 10

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #BDC3C7
    BorderThickness 1.5
    FontName Arial
    FontSize 11
}

skinparam card {
    BackgroundColor #FEF9E7
    BorderColor #F1C40F
    BorderThickness 1.5
    FontName Arial
    FontSize 11
    FontStyle bold
}

skinparam database {
    BackgroundColor #2C3E50
    BorderColor #1A252F
    FontColor white
    FontName Arial
    FontSize 11
    FontStyle bold
}

rectangle "<color:white><b>Start</b></color>" as Start #4D6BFE
rectangle "Buka Form\n'Lapor Kerusakan'" as Step_1
rectangle "Pilih Fasilitas, Isi Kategori &\nDeskripsi, serta Upload Foto" as Step_2 #FAD7A0
rectangle "Klik Tombol\n'Kirim Laporan'" as Step_3
card "◇ Validasi Server:\nForm Lengkap &\nFoto Valid (Max 2MB)?" as Dec_1
database "Database\nLaporan" as DB_Report
rectangle "Simpan Data (Status: 'Baru')\ndan Upload Berkas Foto" as Step_4 #FAD7A0
rectangle "Tampilkan Notifikasi Sukses\nLaporan Terkirim" as Step_5 #D4EFDF;line:27AE60
rectangle "Tampilkan Pesan Error\nFormat / Ukuran Foto" as Step_Err #FDEDEC;line:E74C3C
rectangle "<color:white><b>End</b></color>" as End #4D6BFE

Start -right-> Step_1
Step_1 -right-> Step_2
Step_2 -right-> Step_3
Step_3 -right-> Dec_1

Dec_1 -right-> Step_4 : Valid
Step_4 -right-> DB_Report
DB_Report -right-> Step_5
Step_5 -right-> End

Dec_1 -down-> Step_Err : Tidak Valid
Step_Err -right-> End
@enduml